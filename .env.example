# このファイルをコピーして .env.local を作り、値を入れてください（.env.local はコミットしない）
#   cp .env.example .env.local

# Supabase（ダッシュボード → Project Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 公開してよいキー（sb_publishable_ で始まる）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー側だけで使う秘密のキー（sb_secret_ で始まる）。NEXT_PUBLIC_ を付けない・ブラウザに出さない
SUPABASE_SECRET_KEY=

# アプリの公開URL（マイページURLの生成などに使う）。
# Vercel では空でよい（本番のドメインを自動で使う）。独自ドメインのときだけ入れる
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 稼働表のスプレッドシートへの自動書き出し（任意。docs/setup.md ⑨）
# Google Cloud のサービスアカウントの鍵（JSON ファイルの中身をそのまま）。秘密。NEXT_PUBLIC_ を付けない
GOOGLE_SERVICE_ACCOUNT_JSON=
# Vercel の Cron（10分ごと）が送る合言葉。長いランダムな文字列にする。秘密
CRON_SECRET=
