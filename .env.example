# このファイルをコピーして .env.local を作り、値を入れてください（.env.local はコミットしない）
#   cp .env.example .env.local

# Supabase（ダッシュボード → Project Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 公開してよいキー（sb_publishable_ で始まる）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー側だけで使う秘密のキー（sb_secret_ で始まる）。NEXT_PUBLIC_ を付けない・ブラウザに出さない
SUPABASE_SECRET_KEY=

# アプリの公開URL（マイページURLの生成などに使う）。
# Vercel では空でよい（本番のドメインを自動で使う）。独自ドメインのときだけ入れる
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 稼働表のスプレッドシートへの自動書き出し（任意。docs/setup.md ⑨）
# Google Cloud のサービスアカウントの鍵（JSON ファイルの中身をそのまま）。秘密。NEXT_PUBLIC_ を付けない
GOOGLE_SERVICE_ACCOUNT_JSON=
# シートを自動で読む（Phase 18）: リンク共有のシートを CSV で読むときの Google の場所。テストで偽のスプレッドシート（e2e/mock-sheets.mjs）に向けるときだけ変える
# GOOGLE_DOCS_BASE=https://docs.google.com
# Vercel の Cron（10分ごと）が送る合言葉。長いランダムな文字列にする。秘密
CRON_SECRET=

# AI アシスタント（任意。docs/setup.md ⑪）
# Anthropic のキー（sk-ant- で始まる）。秘密。NEXT_PUBLIC_ を付けない
ANTHROPIC_API_KEY=
# 使うモデルの名前。空なら、使えるもののうち一番新しい高性能のモデル
ANTHROPIC_MODEL=

# LINE 公式アカウントからの自動のお知らせ（任意。docs/setup.md ⑫）。どちらも秘密。NEXT_PUBLIC_ を付けない
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
